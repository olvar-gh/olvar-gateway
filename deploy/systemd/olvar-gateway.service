[Unit]
Description=Olvar gateway (MQTT -> SQLite outbox -> Supabase)
Documentation=https://github.com/olvar-gh/olvar-gateway/blob/main/docs/DEPLOY.md
Wants=network-online.target mosquitto.service
After=network-online.target mosquitto.service

[Service]
Type=simple
User=olvar
Group=olvar
EnvironmentFile=/etc/olvar-gateway/gateway.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/olvar-gateway/venv/bin/python -m olvar_gateway run
Restart=on-failure
RestartSec=10
# Exit status 2 is a configuration error; restarting cannot fix it.
RestartPreventExitStatus=2
# The service flushes the outbox for up to 10 s after SIGTERM.
TimeoutStopSec=30
StateDirectory=olvar-gateway
StateDirectoryMode=0750
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
