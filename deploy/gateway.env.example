# /etc/olvar-gateway/gateway.env (root:olvar 0640). Replace every replace_me, then:
#   sudo systemctl restart olvar-gateway

# Supabase dashboard -> Project Settings -> Data API: the project URL, without /rest/v1
SUPABASE_URL=https://replace_me.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys: the key named "gateway" (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_replace_me

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=olvar-gateway
# The password you typed for the user olvar-gateway in mosquitto_passwd
MQTT_PASSWORD=replace_me

OUTBOX_PATH=/var/lib/olvar-gateway/outbox.db
GATEWAY_ID=olvar-gw
LOG_LEVEL=INFO
