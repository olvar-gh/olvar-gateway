# Local development settings for the gateway. Copy to .env and fill in; never commit .env.
# On the Pi the same variables live in /etc/olvar-gateway/gateway.env (mode 0640).

# Supabase project URL and the named secret key "gateway" (sb_secret_...). Never use a publishable key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Mosquitto on the Pi (LAN, no TLS). The gateway logs in as the reserved user "olvar-gateway".
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=olvar-gateway
MQTT_PASSWORD=replace_me

# Durable SQLite outbox (Pi default: /var/lib/olvar-gateway/outbox.db)
OUTBOX_PATH=./outbox.db

# Row id written to public.gateways by the 5-minute heartbeat
GATEWAY_ID=olvar-gw
